    "test:components:download": "node scripts/test-components-download.mjs --download",
    "test:mcp:packaged": "node scripts/test-mcp-packaged.mjs",
    "test:mcp:ui": "node scripts/test-mcp-settings-ui.mjs",
    "test:engine-settings": "node --test test/engine-settings.test.mjs && node scripts/test-engine-settings-ui.mjs",
    "cua:prepare": "node scripts/prepare-cua-driver.mjs",
    "test:cua": "node --test test/cua-*.test.mjs test/prepare-cua-driver.test.mjs",
    "test:skills": "node scripts/test-skills-ui.mjs",
    "test:terminal": "node --test test/open-terminal.test.mjs && node scripts/test-terminal-ui.mjs",
    "test:terminal:native": "node scripts/test-open-terminal.mjs",
    "test:open-run": "node --test test/open-file.test.mjs && node --test test/run-file.test.mjs && node scripts/test-open-run-ui.mjs",
    "test:conversation-settings": "node scripts/test-conversation-settings-ui.mjs",
    "test:context-notices": "node scripts/test-context-notices-ui.mjs",
    "test:sync": "node scripts/test-sync-settings-ui.mjs",
    "test:model-catalogue": "node scripts/test-model-catalogue-ui.mjs",
    "test:new-session-cwd": "node scripts/test-new-session-cwd-ui.mjs",
    "test:context-extension:native": "node scripts/test-context-extension-native.mjs",
    "test:image-routing:native": "node scripts/test-image-routing-native.mjs",
    "test:imagemodel-guard": "node scripts/test-imagemodel-guard.mjs"
