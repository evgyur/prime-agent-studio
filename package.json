    "test:child-completion:native": "node scripts/test-child-completion-native.mjs",
    "test:reasoning": "node scripts/test-reasoning-ui.mjs",
    "test:remote-access": "node scripts/test-remote-access-ui.mjs",
    "test:explorer": "node scripts/test-open-directory.mjs",
    "test:folders": "node scripts/test-folder-ui.mjs && node scripts/test-project-folder-color-ui.mjs",
    "test:layout": "node scripts/test-mobile-layout.mjs",
    "test:attachments": "node scripts/test-attachments-ui.mjs",
    "test:voice": "node --test test/voice.test.mjs && node --test --test-name-pattern=voice test/server.test.mjs test/lan.test.mjs && node scripts/test-voice-ui.mjs",
    "test:interactions": "node scripts/test-interactions-ui.mjs && node scripts/test-questions-carousel-ui.mjs",
    "test:interactions:scroll": "node scripts/test-interactions-scroll.mjs",
