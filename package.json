    "test:providers": "node scripts/test-providers-ui.mjs",
    "test:worktrees": "node --test test/worktrees.test.mjs test/worktree-routes.test.mjs && node scripts/test-worktrees-ui.mjs",
    "test:commands": "node scripts/test-commands-ui.mjs && node scripts/test-command-chips.mjs && node scripts/test-composer-slash-ui.mjs",
