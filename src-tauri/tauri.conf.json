{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prime Agent Studio",
  "version": "../package.json",
  "identifier": "com.primeagent.studio",
  "build": {
    "frontendDist": "../desktop",
    "beforeBuildCommand": "node scripts/build-desktop-resources.mjs",
    "beforeDevCommand": "node scripts/build-desktop-resources.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "capabilities": [
        {
          "identifier": "launcher",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "allow-desktop-state",
            "allow-desktop-components",
            "allow-desktop-components-cancel",
            "allow-desktop-components-open",
            "allow-desktop-autostart",
            "allow-desktop-choose-legacy",
            "allow-desktop-logs",
            "allow-desktop-start",
            "allow-desktop-update-status",
            "allow-desktop-update-operation",
            "allow-desktop-update-cancel",
            "allow-desktop-server-restart",
            "allow-desktop-quit",
            "allow-desktop-port-state",
            "allow-desktop-port-set",
            "allow-desktop-update-check",
            "allow-desktop-update-install"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": {
      "../.desktop-build/": "backend/"
    },
    "publisher": "zerr0o",
    "copyright": "Copyright (c) zerr0o",
    "shortDescription": "Votre espace de travail pour Prime Agent",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "Prime Agent Studio"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/zerr0o/prime-agent-studio/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNjdBNjFBMTM5MTlBRjMKUldUem1wRVRHcVpuSCs3NG5TeVNCYUpXVE9ldndiendudUtpbkEreGtRcGNkUDRxVXhlbmFsc0oK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
